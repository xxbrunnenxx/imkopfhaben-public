[Unit]
Description=imkopfhaben Brain (STT + LLM Backend)
After=network.target

[Service]
Type=simple
User=kraken
WorkingDirectory=/home/kraken/imkopfhaben-brain
ExecStart=/home/kraken/imkopfhaben-brain/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
